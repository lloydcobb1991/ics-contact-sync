# ---- Mode ----
# dry-run = read, diff, queue, report, but never write to Mailchimp. Stay here until Phase 3.
SYNC_MODE=dry-run

# ---- Mailchimp ----
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
MAILCHIMP_LIST_MASTER=        # ICS Conversations Master audience ID
MAILCHIMP_LIST_RFP=           # RFP+APL General audience ID

# ---- Snapshot store (GitHub). Token: fine-grained, this repo only, Contents read + write ----
GITHUB_TOKEN=
SNAPSHOT_REPO=ignitecs/ics-contact-sync-snapshots
SNAPSHOT_DIR=snapshots          # folder of vault CSV exports: all.csv, or alterra.csv / swingers.csv

# ---- Airtable (the portal's Mailchimp module base) ----
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_RUNS=Sync Runs
AIRTABLE_TABLE_CHANGES=Sync Changes
AIRTABLE_TABLE_AUDIT=Sync Audit

# ---- People ----
APPROVER_EMAILS=celia@ignitecs.co,ryan@ignitecs.co      # confirm Ryan's address
UPLOADER_EMAILS=lloyd@ignitecs.co                       # who can drop the weekly vault export (confirm address)
REPORT_RECIPIENTS=celia@ignitecs.co,ryan@ignitecs.co,lloyd@ignitecs.co
ALERT_RECIPIENTS=lloyd@ignitecs.co

# ---- SendGrid ----
SENDGRID_API_KEY=
REPORT_FROM=sync@ignitecs.co
PORTAL_URL=https://portal.ignitecs.co/contact-sync
